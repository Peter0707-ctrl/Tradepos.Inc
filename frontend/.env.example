# TradePOS Production & Deployment Environment Variables
# Copy this file to .env.local for local testing or configure on Railway / Vercel

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pesapal Payment Gateway v3
# Set to 'sandbox' for testing or 'production' for live payments
PESAPAL_ENV=sandbox

# Pesapal API Credentials (Obtain from https://developer.pesapal.com/)
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key_here
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret_here

# Pesapal Registered IPN ID (from Pesapal merchant dashboard)
PESAPAL_IPN_ID=your_ipn_id_here

# TradePOS Direct Till / Lipa Namba Details
NEXT_PUBLIC_LIPA_TILL_NUMBER=5542109
NEXT_PUBLIC_LIPA_BUSINESS_NAME=TradePOS Technologies Tanzania
